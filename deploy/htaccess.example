# Ejemplo para Apache: copia este archivo como .htaccess en la raíz del sitio.
# Requiere mod_rewrite, mod_headers y mod_expires.

# Forzar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # index.html siempre se revalida
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # js/css del bundle: caché larga (protegidos por ?v=<hash>)
  <FilesMatch "^spicy-renderer\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # fuentes: nombre estable, caché larga sin immutable
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
